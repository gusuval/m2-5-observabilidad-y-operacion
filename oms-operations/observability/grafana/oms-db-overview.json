      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (replica) (cloudsql_replication_lag_seconds)",
          "legendFormat": "{{replica}}",
          "refId": "A",
          "range": true

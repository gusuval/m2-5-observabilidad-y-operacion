      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(cloudsql_cpu_utilization{database_id=\"oms-production:oms-pg-prod\"})",
          "legendFormat": "cpu",

{
  "uid": "oms-deploys",
  "title": "OMS · Despliegues y canary",
  "description": "",
  "tags": [
    "oms",
    "deploys",
    "canary"
  ],
  "timezone": "Europe/Madrid",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Managed Prometheus (oms-production)",
          "value": "oms-prod-prometheus"
        },
        "hide": 0
      },
      {
        "name": "service",
        "label": "Servicio",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(http_requests_total{job=~\"oms-.*\"}, job)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "includeAll": false,
        "multi": true,
        "current": {}
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Despliegues",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "purple",
        "expr": "changes(run_revision_traffic_percent{tag=\"canary\"}[2m]) > 0",
        "titleFormat": "Canary {{job}} {{revision}} → {{tag}}"
      }
    ]
  },
  "links": [
    {
      "title": "Índice de runbooks",
      "url": "https://runbooks.example.com/",
      "targetBlank": true,
      "type": "link"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Canary: revisión nueva vs estable (runbook 07)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tráfico por revisión",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (revision) (rate(http_requests_total{job=\"$service\"}[5m]))",
          "legendFormat": "{{revision}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "links": [
        {
          "title": "Runbook 07-canary-rollout-failed",
          "url": "https://runbooks.example.com/07-canary-rollout-failed",
          "targetBlank": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Errores 5xx por revisión",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (revision) (rate(http_requests_total{job=\"$service\", code=~\"5..\"}[5m])) / sum by (revision) (rate(http_requests_total{job=\"$service\"}[5m]))",
          "legendFormat": "{{revision}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "links": [
        {
          "title": "Runbook 07-canary-rollout-failed",
          "url": "https://runbooks.example.com/07-canary-rollout-failed",
          "targetBlank": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "p95 por revisión",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, revision) (rate(http_request_duration_seconds_bucket{job=\"$service\"}[5m])))",
          "legendFormat": "{{revision}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "links": [
        {
          "title": "Runbook 07-canary-rollout-failed",
          "url": "https://runbooks.example.com/07-canary-rollout-failed",
          "targetBlank": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "% de tráfico por revisión (etapas 10 → 50 → 100)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (revision, tag) (run_revision_traffic_percent{job=\"$service\"})",
          "legendFormat": "{{tag}} {{revision}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "links": [
        {
          "title": "Runbook 07-canary-rollout-failed",
          "url": "https://runbooks.example.com/07-canary-rollout-failed",
          "targetBlank": true
        }
      ]
    }
  ]
}
